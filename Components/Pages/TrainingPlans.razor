@page "/training-plans"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using ProjektAWiMDDD.Data
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Plany Treningowe</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Moje Plany Treningowe</h3>
    <a href="/training-plans/create" class="btn btn-success">+ Nowy Plan</a>
</div>

@if (isLoading)
{
    <p><em>Ładowanie planów...</em></p>
}
else if (plans.Count == 0)
{
    <div class="alert alert-warning">
        Nie masz jeszcze żadnych planów treningowych. Kliknij <strong>+ Nowy Plan</strong>, aby utworzyć pierwszy.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var plan in plans)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@plan.Name</h5>
                        <p class="card-text text-muted">
                            @(string.IsNullOrWhiteSpace(plan.Description) ? "Brak opisu" : plan.Description)
                        </p>
                        <span class="badge bg-secondary">Liczba ćwiczeń: @plan.ExerciseCount</span>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between">
                        <a href="/training-plans/@plan.Id" class="btn btn-sm btn-outline-primary">Szczegóły</a>
                        <div>
                            <a href="/training-plans/edit/@plan.Id" class="btn btn-sm btn-outline-warning me-1">Edytuj</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlanAsync(plan.Id)">Usuń</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<TrainingPlanDto> plans = [];
    private string? userId;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        isLoading = true;
        if (userId is not null)
        {
            plans = await Db.TrainingPlans
                .AsNoTracking()
                .Where(p => p.UserId == userId)
                .Select(p => new TrainingPlanDto(p.Id, p.Name, p.Description, p.Exercises.Count))
                .ToListAsync();
        }
        isLoading = false;
    }

    private async Task DeletePlanAsync(int id)
    {
        var plan = await Db.TrainingPlans.FirstOrDefaultAsync(p => p.Id == id && p.UserId == userId);
        if (plan is not null)
        {
            Db.TrainingPlans.Remove(plan);
            await Db.SaveChangesAsync();
            await LoadPlansAsync();
        }
    }
}