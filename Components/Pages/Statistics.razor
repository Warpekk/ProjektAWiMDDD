@page "/statistics"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using ProjektAWiMDDD.Dtos
@using ProjektAWiMDDD.Services

@inject FitnessApiService Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Statystyki - FitPlanner</PageTitle>

<div class="statistics-page">
    @if (!isAuthenticated)
    {
        <div class="alert alert-warning mt-4">
            <h5>Nie jesteś zalogowany</h5>
            <p>Zaloguj się, aby zobaczyć swoje statystyki.</p>
            <a href="/login" class="btn btn-primary">Zaloguj się</a>
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3">Ładowanie statystyk...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else if (statistics is null || statistics.TotalWorkouts == 0)
    {
        <div class="alert alert-info">
            <h5>Brak danych treningowych</h5>
            <p class="mb-0">
                Zakończ pierwszy trening, aby zobaczyć swoje statystyki.
            </p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Statystyki treningowe</h2>
                <p class="text-muted mb-0">
                    Podsumowanie całej historii Twoich treningów.
                </p>
            </div>

            <button class="btn btn-outline-primary"
                    @onclick="LoadStatisticsAsync"
                    disabled="@isLoading">
                Odśwież dane
            </button>
        </div>
        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-label">Liczba treningów</div>
                    <div class="stat-value">
                        @statistics.TotalWorkouts
                    </div>
                    <div class="stat-description">
                        @MonthComparisonText
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-label">Łączny czas treningów</div>
                    <div class="stat-value">
                        @FormatDuration(statistics.TotalDurationMinutes)
                    </div>
                    <div class="stat-description">
                        Średnio @statistics.AverageDurationMinutes.ToString("0") min na trening
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-label">Łączna objętość</div>
                    <div class="stat-value">
                        @FormatNumber(statistics.TotalVolume) kg
                    </div>
                    <div class="stat-description">
                        Średnio @FormatNumber(statistics.AverageVolumePerWorkout) kg na trening
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-label">Wykonane serie</div>
                    <div class="stat-value">
                        @statistics.TotalSets
                    </div>
                    <div class="stat-description">
                        We wszystkich zakończonych treningach
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-4 mb-4">

            <div class="col-12 col-xl-6">
                <div class="statistics-card h-100">
                    <h5>Aktywność treningowa</h5>
                    <p class="text-muted small">
                        Liczba zakończonych treningów w poszczególnych miesiącach.
                    </p>

                    @if (statistics.MonthlyStatistics.Count == 0)
                    {
                        <p class="text-muted">Brak danych do wykresu.</p>
                    }
                    else
                    {
                        var maxWorkouts = Math.Max(
                            1,
                            statistics.MonthlyStatistics.Max(x => x.Workouts));

                        <div class="bar-chart">
                            @foreach (var item in statistics.MonthlyStatistics)
                            {
                                var width = item.Workouts * 100.0 / maxWorkouts;

                                <div class="bar-row">
                                    <div class="bar-label">@item.Month</div>

                                    <div class="bar-track">
                                        <div class="bar-fill workouts-fill"
                                             style="width: @(width)%">
                                        </div>
                                    </div>

                                    <div class="bar-value">@item.Workouts</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="statistics-card h-100">
                    <h5>Objętość treningowa</h5>
                    <p class="text-muted small">
                        Suma ciężaru pomnożonego przez liczbę powtórzeń.
                    </p>

                    @if (statistics.MonthlyStatistics.Count == 0)
                    {
                        <p class="text-muted">Brak danych do wykresu.</p>
                    }
                    else
                    {
                        var maxVolume = Math.Max(
                            1m,
                            statistics.MonthlyStatistics.Max(x => x.Volume));

                        <div class="bar-chart">
                            @foreach (var item in statistics.MonthlyStatistics)
                            {
                                var width = (double)(item.Volume * 100m / maxVolume);

                                <div class="bar-row">
                                    <div class="bar-label">@item.Month</div>

                                    <div class="bar-track">
                                        <div class="bar-fill volume-fill"
                                             style="width: @(width)%">
                                        </div>
                                    </div>

                                    <div class="bar-value">
                                        @FormatNumber(item.Volume)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="row g-4 mb-4">

            <div class="col-12 col-xl-6">
                <div class="statistics-card h-100">
                    <h5>Rozkład grup mięśniowych</h5>
                    <p class="text-muted small">
                        Liczba zarejestrowanych serii dla każdej grupy.
                    </p>

                    @if (statistics.MuscleGroupStatistics.Count == 0)
                    {
                        <p class="text-muted">
                            Brak zarejestrowanych serii.
                        </p>
                    }
                    else
                    {
                        var maxSets = Math.Max(
                            1,
                            statistics.MuscleGroupStatistics.Max(x => x.Sets));

                        @foreach (var group in statistics.MuscleGroupStatistics)
                        {
                            var width = group.Sets * 100.0 / maxSets;

                            <div class="muscle-row">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>@TranslateMuscleGroup(group.MuscleGroup)</span>
                                    <strong>@group.Sets serii</strong>
                                </div>

                                <div class="bar-track">
                                    <div class="bar-fill muscle-fill"
                                         style="width: @(width)%">
                                    </div>
                                </div>

                                <div class="text-muted small mt-1">
                                    Objętość: @FormatNumber(group.Volume) kg
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="statistics-card h-100">
                    <h5>Najczęściej wykonywane ćwiczenia</h5>
                    <p class="text-muted small">
                        Pięć ćwiczeń z największą liczbą zarejestrowanych serii.
                    </p>

                    @if (statistics.TopExercises.Count == 0)
                    {
                        <p class="text-muted">
                            Brak zarejestrowanych ćwiczeń.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Ćwiczenie</th>
                                        <th class="text-end">Serie</th>
                                        <th class="text-end">Objętość</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var exercise in statistics.TopExercises)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                @exercise.ExerciseName
                                            </td>
                                            <td class="text-end">
                                                @exercise.Sets
                                            </td>
                                            <td class="text-end">
                                                @FormatNumber(exercise.Volume) kg
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="statistics-card mb-5">
            <h5>Największe użyte ciężary</h5>
            <p class="text-muted small">
                Największy ciężar zarejestrowany dla każdego ćwiczenia.
            </p>

            @if (statistics.ExerciseRecords.Count == 0)
            {
                <p class="text-muted">
                    Brak zarejestrowanych rekordów.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Ćwiczenie</th>
                                <th class="text-end">Maksymalny ciężar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in statistics.ExerciseRecords)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @record.ExerciseName
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-primary">
                                            @record.MaxWeight.ToString("0.##") kg
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

</div>

<style>
    .statistics-page {
        padding-bottom: 30px;
    }

    .stat-card {
        height: 100%;
        padding: 22px;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.035);
    }

    .stat-label {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .stat-value {
        font-size: clamp(24px, 3vw, 32px);
        font-weight: 750;
        color: #111827;
        overflow-wrap: anywhere;
    }

    .stat-description {
        color: #6b7280;
        font-size: 12px;
        margin-top: 8px;
    }

    .statistics-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.035);
    }

        .statistics-card h5 {
            font-weight: 700;
            margin-bottom: 8px;
        }

    .bar-chart {
        margin-top: 24px;
    }

    .bar-row {
        display: grid;
        grid-template-columns: 75px minmax(40px, 1fr) 65px;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .bar-label {
        font-size: 12px;
        color: #6b7280;
        white-space: nowrap;
    }

    .bar-track {
        width: 100%;
        height: 13px;
        background: #f1f5f9;
        border-radius: 20px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        min-width: 2px;
        border-radius: 20px;
        transition: width 0.3s ease;
    }

    .workouts-fill {
        background: #2563eb;
    }

    .volume-fill {
        background: #16a34a;
    }

    .muscle-fill {
        background: #7c3aed;
    }

    .bar-value {
        font-size: 12px;
        text-align: right;
        font-weight: 600;
        color: #374151;
        white-space: nowrap;
    }

    .muscle-row {
        margin-top: 20px;
    }

    .statistics-card .table {
        margin-top: 15px;
    }

    @@media (max-width: 576px) {
        .statistics-card {
            padding: 17px;
        }

        .stat-card {
            padding: 17px;
        }

        .bar-row {
            grid-template-columns: 62px minmax(30px, 1fr) 48px;
            gap: 7px;
        }
    }
</style>

@code {
    private StatisticsDto? statistics;

    private bool isLoading = true;
    private bool isAuthenticated;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        isAuthenticated =
            authState.User.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            await LoadStatisticsAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadStatisticsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            statistics = await Api.GetStatisticsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Nie udało się pobrać statystyk. Sprawdź połączenie z API.";
        }
        catch (Exception)
        {
            errorMessage = "Wystąpił nieoczekiwany błąd podczas pobierania statystyk.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string MonthComparisonText
    {
        get
        {
            if (statistics is null)
                return "";

            var current = statistics.CurrentMonthWorkouts;
            var previous = statistics.PreviousMonthWorkouts;

            if (previous == 0 && current == 0)
                return "Brak treningów w bieżącym i poprzednim miesiącu";

            if (previous == 0)
                return $"{current} treningów w bieżącym miesiącu";

            var difference = current - previous;

            if (difference > 0)
                return $"+{difference} względem poprzedniego miesiąca";

            if (difference < 0)
                return $"{difference} względem poprzedniego miesiąca";

            return "Tyle samo co w poprzednim miesiącu";
        }
    }

    private static string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var remainingMinutes = minutes % 60;

        if (hours == 0)
            return $"{remainingMinutes} min";

        if (remainingMinutes == 0)
            return $"{hours} h";

        return $"{hours} h {remainingMinutes} min";
    }

    private static string FormatNumber(decimal value)
    {
        return value.ToString("#,##0.##");
    }

    private static string TranslateMuscleGroup(string group)
    {
        return group switch
        {
            "Chest" => "Klatka piersiowa",
            "Back" => "Plecy",
            "Legs" => "Nogi",
            "Shoulders" => "Barki",
            "Arms" => "Ramiona",
            "Core" => "Brzuch",
            "FullBody" => "Całe ciało",
            "Cardio" => "Cardio",
            _ => group
        };
    }
}