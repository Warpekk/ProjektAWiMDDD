@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ProjektAWiMDDD.Models
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject NavigationManager Nav

<PageTitle>Rejestracja</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title mb-3 text-center">Utwórz konto</h3>

                @if (errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var err in errors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }

                <EditForm Model="Input" method="post" OnValidSubmit="RegisterUserAsync" FormName="registerForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Adres e-mail</label>
                        <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" />
                        <ValidationMessage For="() => Input.Email" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hasło</label>
                        <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" />
                        <ValidationMessage For="() => Input.Password" class="text-danger" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Potwierdź hasło</label>
                        <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">Zarejestruj się</button>
                </EditForm>

                <div class="mt-3 text-center">
                    <span>Masz już konto? <a href="/login">Zaloguj się</a></span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterInputModel Input { get; set; } = new();

    private List<string> errors = [];

    private async Task RegisterUserAsync()
    {
        errors.Clear();

        var user = new User
        {
            UserName = Input.Email,
            Email = Input.Email
        };

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (result.Succeeded)
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            Nav.NavigateTo("/training-plans");
            return;
        }

        errors = result.Errors.Select(e => e.Description).ToList();
    }

    private sealed class RegisterInputModel
    {
        [Required(ErrorMessage = "Adres e-mail jest wymagany.")]
        [EmailAddress(ErrorMessage = "Niepoprawny format adresu e-mail.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Hasło jest wymagane.")]
        [MinLength(6, ErrorMessage = "Hasło musi mieć co najmniej 6 znaków.")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "Hasła nie są identyczne.")]
        public string ConfirmPassword { get; set; } = "";
    }
}